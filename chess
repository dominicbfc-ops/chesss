"""Play chess against a small minimax AI in the terminal.

Install the only dependency with:
	python -m pip install python-chess
Run with:
	python chess_bot.py
"""

from __future__ import annotations

import math
import json
import random
import socket
import sys
import threading
import tkinter as tk
from tkinter import messagebox, ttk
from typing import Optional

import chess


PIECE_VALUES = {
	chess.PAWN: 100,
	chess.KNIGHT: 320,
	chess.BISHOP: 330,
	chess.ROOK: 500,
	chess.QUEEN: 900,
	chess.KING: 20_000,
}


def evaluate(board: chess.Board) -> int:
	"""Return a score from White's perspective."""
	if board.is_checkmate():
		return -100_000 if board.turn == chess.WHITE else 100_000
	if board.is_stalemate() or board.is_insufficient_material() or board.is_fifty_moves():
		return 0

	score = 0
	for piece_type, value in PIECE_VALUES.items():
		score += len(board.pieces(piece_type, chess.WHITE)) * value
		score -= len(board.pieces(piece_type, chess.BLACK)) * value

	# Mobility and center control make shallow searches feel less random.
	score += 3 * (board.legal_moves.count() if board.turn == chess.WHITE else -board.legal_moves.count())
	for square in chess.SQUARES:
		piece = board.piece_at(square)
		if piece is not None and chess.square_file(square) in (3, 4) and chess.square_rank(square) in (3, 4):
			score += 12 if piece.color == chess.WHITE else -12
	return score


def ordered_moves(board: chess.Board) -> list[chess.Move]:
	"""Search forcing and valuable moves first for better alpha-beta pruning."""
	return sorted(
		board.legal_moves,
		key=lambda move: (
			board.is_capture(move),
			move.promotion is not None,
			board.gives_check(move),
		),
		reverse=True,
	)


def minimax(board: chess.Board, depth: int, alpha: float, beta: float, maximizing: bool) -> int:
	if depth == 0 or board.is_game_over(claim_draw=True):
		return evaluate(board)

	if maximizing:
		best = -math.inf
		for move in ordered_moves(board):
			board.push(move)
			best = max(best, minimax(board, depth - 1, alpha, beta, False))
			board.pop()
			alpha = max(alpha, best)
			if beta <= alpha:
				break
		return int(best)

	best = math.inf
	for move in ordered_moves(board):
		board.push(move)
		best = min(best, minimax(board, depth - 1, alpha, beta, True))
		board.pop()
		beta = min(beta, best)
		if beta <= alpha:
			break
	return int(best)


def choose_move(board: chess.Board, depth: int) -> chess.Move:
	"""Choose the best move for the side to move."""
	maximizing = board.turn == chess.WHITE
	best_score = -math.inf if maximizing else math.inf
	best_moves: list[chess.Move] = []

	for move in ordered_moves(board):
		board.push(move)
		score = minimax(board, depth - 1, -math.inf, math.inf, not maximizing)
		board.pop()
		if (maximizing and score > best_score) or (not maximizing and score < best_score):
			best_score = score
			best_moves = [move]
		elif score == best_score:
			best_moves.append(move)

	return random.choice(best_moves)


def print_board(board: chess.Board) -> None:
	light_square = "\033[48;5;250m"
	dark_square = "\033[48;5;65m"
	white_piece = "\033[38;5;255m"
	black_piece = "\033[38;5;16m"
	reset = "\033[0m"
	files = "    a   b   c   d   e   f   g   h"

	print("\n" + files)
	print("  +---+---+---+---+---+---+---+---+")
	for rank in range(7, -1, -1):
		cells = []
		for file_index in range(8):
			square = chess.square(file_index, rank)
			piece = board.piece_at(square)
			background = light_square if (file_index + rank) % 2 else dark_square
			foreground = white_piece if piece is None or piece.color == chess.WHITE else black_piece
			glyph = piece.unicode_symbol() if piece else " "
			cells.append(f"{background}{foreground} {glyph} {reset}")
		print(f"{rank + 1} |" + "|".join(cells) + f"| {rank + 1}")
		print("  +---+---+---+---+---+---+---+---+")
	print(files)

	turn = "White" if board.turn == chess.WHITE else "Black"
	status = "CHECK" if board.is_check() else f"{turn} to move"
	material = []
	for color, name in ((chess.WHITE, "White"), (chess.BLACK, "Black")):
		value = sum(
			len(board.pieces(piece_type, color)) * PIECE_VALUES[piece_type]
			for piece_type in PIECE_VALUES
		)
		material.append(f"{name}: {value // 100}.{value % 100:02d}")
	print(f"\n  {status}    |    {'    |    '.join(material)}")


def parse_move(board: chess.Board, text: str) -> Optional[chess.Move]:
	"""Parse SAN first, then coordinate notation such as e2e4."""
	try:
		return board.parse_san(text)
	except ValueError:
		try:
			move = chess.Move.from_uci(text.lower())
		except ValueError:
			return None
		return move if move in board.legal_moves else None


def gui_main(initial_depth: int = 2) -> None:
	"""Launch a draggable Tkinter chess board."""
	root = tk.Tk()
	root.title("AI Chess Bot")
	root.configure(bg="#18232b")

	board = chess.Board()
	history: list[chess.Move] = []
	selected: Optional[chess.Square] = None
	ai_thinking = False
	square_size = 76
	light = "#f0d9b5"
	dark = "#b58863"
	highlight = "#d6c35a"
	canvas = tk.Canvas(root, width=square_size * 8, height=square_size * 8, highlightthickness=0)
	canvas.grid(row=0, column=0, rowspan=2, padx=(18, 10), pady=18)

	status = tk.StringVar(value="Your turn - drag a white piece")
	difficulty = tk.IntVar(value=initial_depth)
	info = tk.Frame(root, bg="#18232b", width=210)
	info.grid(row=0, column=1, sticky="nsew", padx=(4, 18), pady=18)
	tk.Label(info, text="AI CHESS BOT", foreground="#f5f1e8", background="#18232b", font=("Segoe UI", 16, "bold")).pack(anchor="w")
	tk.Label(info, textvariable=status, foreground="#cbd5d8", background="#18232b", wraplength=190, justify="left").pack(anchor="w", pady=(12, 20))
	tk.Label(info, text="Difficulty", foreground="#f5f1e8", background="#18232b").pack(anchor="w")
	tk.Spinbox(info, from_=1, to=3, textvariable=difficulty, width=5).pack(anchor="w", pady=(4, 18))
	tk.Button(info, text="New game", command=lambda: new_game()).pack(fill="x", pady=3)
	tk.Button(info, text="Clear board", command=lambda: clear_board()).pack(fill="x", pady=3)
	tk.Button(info, text="Undo move", command=lambda: undo()).pack(fill="x", pady=3)
	tk.Label(info, text="Drag a piece to a highlighted square.\nYou play White.", foreground="#91a3a8", background="#18232b", justify="left").pack(anchor="w", pady=(22, 0))

	def square_at(event: tk.Event) -> chess.Square:
		file_index = max(0, min(7, int(event.x // square_size)))
		rank = 7 - max(0, min(7, int(event.y // square_size)))
		return chess.square(file_index, rank)

	def draw() -> None:
		canvas.delete("all")
		legal_targets = {move.to_square for move in board.legal_moves if selected is not None and move.from_square == selected}
		for rank in range(7, -1, -1):
			for file_index in range(8):
				square = chess.square(file_index, rank)
				x = file_index * square_size
				y = (7 - rank) * square_size
				color = light if (file_index + rank) % 2 else dark
				if square == selected or square in legal_targets:
					color = highlight
				canvas.create_rectangle(x, y, x + square_size, y + square_size, fill=color, outline=color)
				piece = board.piece_at(square)
				if piece:
					canvas.create_text(x + square_size / 2, y + square_size / 2, text=piece.unicode_symbol(), font=("Segoe UI Symbol", 44))
		for file_index, label in enumerate("abcdefgh"):
			canvas.create_text(file_index * square_size + 8, 8 * square_size - 13, text=label, anchor="w", fill="#5b4636", font=("Segoe UI", 9, "bold"))
		for rank in range(8):
			canvas.create_text(8 * square_size - 8, (7 - rank) * square_size + 8, text=str(rank + 1), anchor="e", fill="#5b4636", font=("Segoe UI", 9, "bold"))

	def finish_status() -> None:
		if board.is_checkmate():
			winner = "Black" if board.turn == chess.WHITE else "White"
			status.set(f"CHECKMATE - {winner} wins!")
		elif board.is_game_over(claim_draw=True):
			outcome = board.outcome(claim_draw=True)
			status.set(f"Game over: {board.result(claim_draw=True)} ({outcome.termination.name.replace('_', ' ').title()})")
		elif board.is_check():
			status.set("Check - your turn" if board.turn == chess.WHITE else "Check - AI is thinking")
		else:
			status.set("Your turn - drag a white piece" if board.turn == chess.WHITE else "AI is thinking...")

	def ai_turn() -> None:
		nonlocal ai_thinking
		if board.is_game_over(claim_draw=True):
			ai_thinking = False
			finish_status()
			return
		move = choose_move(board, max(1, min(3, difficulty.get())))
		board.push(move)
		history.append(move)
		ai_thinking = False
		draw()
		finish_status()

	def on_press(event: tk.Event) -> None:
		nonlocal selected
		if ai_thinking or board.turn != chess.WHITE:
			return
		square = square_at(event)
		piece = board.piece_at(square)
		if piece and piece.color == chess.WHITE:
			selected = square
			draw()

	def on_release(event: tk.Event) -> None:
		nonlocal selected, ai_thinking
		if selected is None or ai_thinking:
			return
		from_square = selected
		to_square = square_at(event)
		selected = None
		move = next((candidate for candidate in board.legal_moves if candidate.from_square == from_square and candidate.to_square == to_square), None)
		if move is None:
			draw()
			return
		if move.promotion:
			move = chess.Move(from_square, to_square, promotion=chess.QUEEN)
		board.push(move)
		history.append(move)
		draw()
		finish_status()
		if not board.is_game_over(claim_draw=True):
			ai_thinking = True
			root.after(80, ai_turn)

	def new_game() -> None:
		nonlocal board, history, selected, ai_thinking
		board = chess.Board()
		history = []
		selected = None
		ai_thinking = False
		draw()
		finish_status()

	def clear_board() -> None:
		nonlocal history, selected, ai_thinking
		board.clear()
		history = []
		selected = None
		ai_thinking = False
		draw()
		status.set("Board cleared - press New game to restart")

	def undo() -> None:
		nonlocal selected
		if ai_thinking:
			return
		if len(history) >= 2:
			board.pop()
			board.pop()
			del history[-2:]
			selected = None
			draw()
			finish_status()

	canvas.bind("<ButtonPress-1>", on_press)
	canvas.bind("<ButtonRelease-1>", on_release)
	draw()
	root.mainloop()


def online_gui_main(host: str, port: int) -> None:
	"""Connect to the authoritative server and play by dragging pieces."""
	root = tk.Tk()
	root.title("AI Chess Bot - Online")
	root.configure(bg="#18232b")
	square_size = 76
	light, dark, highlight = "#f0d9b5", "#b58863", "#d6c35a"
	canvas = tk.Canvas(root, width=square_size * 8, height=square_size * 8, highlightthickness=0)
	canvas.grid(row=0, column=0, padx=(18, 10), pady=18)
	status = tk.StringVar(value="Connecting...")
	info = tk.Frame(root, bg="#18232b")
	info.grid(row=0, column=1, sticky="nsew", padx=(4, 18), pady=18)
	tk.Label(info, text="ONLINE CHESS", foreground="#f5f1e8", background="#18232b", font=("Segoe UI", 16, "bold")).pack(anchor="w")
	tk.Label(info, textvariable=status, foreground="#cbd5d8", background="#18232b", wraplength=190, justify="left").pack(anchor="w", pady=(12, 20))
	tk.Label(info, text=f"Server: {host}:{port}", foreground="#91a3a8", background="#18232b").pack(anchor="w")

	board = chess.Board()
	player_color: Optional[chess.Color] = None
	selected: Optional[chess.Square] = None
	send_lock = threading.Lock()
	connection = socket.create_connection((host, port), timeout=10)
	reader = connection.makefile("r", encoding="utf-8")

	def send(message: dict) -> None:
		payload = (json.dumps(message) + "\n").encode("utf-8")
		with send_lock:
			connection.sendall(payload)

	def draw() -> None:
		canvas.delete("all")
		flipped = player_color == chess.BLACK
		legal_targets = {move.to_square for move in board.legal_moves if selected is not None and move.from_square == selected}
		for display_rank in range(8):
			for display_file in range(8):
				file_index = 7 - display_file if flipped else display_file
				rank = display_rank if flipped else 7 - display_rank
				square = chess.square(file_index, rank)
				x, y = display_file * square_size, display_rank * square_size
				color = light if (file_index + rank) % 2 else dark
				if square == selected or square in legal_targets:
					color = highlight
				canvas.create_rectangle(x, y, x + square_size, y + square_size, fill=color, outline=color)
				piece = board.piece_at(square)
				if piece:
					canvas.create_text(x + square_size / 2, y + square_size / 2, text=piece.unicode_symbol(), font=("Segoe UI Symbol", 44))
		for display_file, label in enumerate("hgfedcba" if flipped else "abcdefgh"):
			canvas.create_text(display_file * square_size + 8, 8 * square_size - 13, text=label, anchor="w", fill="#5b4636", font=("Segoe UI", 9, "bold"))
		for display_rank in range(8):
			label = str(display_rank + 1) if flipped else str(8 - display_rank)
			canvas.create_text(8 * square_size - 8, display_rank * square_size + 8, text=label, anchor="e", fill="#5b4636", font=("Segoe UI", 9, "bold"))

	def square_at(event: tk.Event) -> chess.Square:
		display_file = max(0, min(7, int(event.x // square_size)))
		display_rank = max(0, min(7, int(event.y // square_size)))
		if player_color == chess.BLACK:
			return chess.square(7 - display_file, display_rank)
		return chess.square(display_file, 7 - display_rank)

	def handle_message(message: dict) -> None:
		nonlocal board, player_color
		message_type = message.get("type")
		if message_type == "welcome":
			player_color = chess.WHITE if message["color"] == "white" else chess.BLACK
			status.set(f"You are {message['color'].title()} - waiting for the game")
			draw()
		elif message_type == "state":
			board = chess.Board(message["fen"])
			draw()
			status.set("Your turn" if (board.turn == player_color) else "Opponent's turn")
		elif message_type == "error":
			status.set(message.get("message", "Server error"))
		elif message_type == "game_over":
			status.set("CHECKMATE" if message.get("checkmate") else f"Game over: {message['result']}")
			messagebox.showinfo("Game over", status.get())

	def receive_messages() -> None:
		try:
			for line in reader:
				message = json.loads(line)
				root.after(0, handle_message, message)
		except (ConnectionError, OSError, json.JSONDecodeError):
			root.after(0, status.set, "Disconnected from server")

	def on_press(event: tk.Event) -> None:
		nonlocal selected
		if player_color is None or board.turn != player_color:
			return
		square = square_at(event)
		piece = board.piece_at(square)
		if piece and piece.color == player_color:
			selected = square
			draw()

	def on_release(event: tk.Event) -> None:
		nonlocal selected
		if selected is None or player_color is None or board.turn != player_color:
			return
		from_square, to_square = selected, square_at(event)
		selected = None
		move = next((candidate for candidate in board.legal_moves if candidate.from_square == from_square and candidate.to_square == to_square), None)
		if move is not None:
			if move.promotion:
				move = chess.Move(from_square, to_square, promotion=chess.QUEEN)
			send({"type": "move", "uci": move.uci()})
		draw()

	canvas.bind("<ButtonPress-1>", on_press)
	canvas.bind("<ButtonRelease-1>", on_release)
	threading.Thread(target=receive_messages, daemon=True).start()
	root.protocol("WM_DELETE_WINDOW", lambda: (connection.close(), root.destroy()))
	root.mainloop()


def main() -> None:
	if "--online" in sys.argv:
		index = sys.argv.index("--online")
		host = sys.argv[index + 1] if len(sys.argv) > index + 1 else "127.0.0.1"
		port = int(sys.argv[index + 2]) if len(sys.argv) > index + 2 else 8765
		online_gui_main(host, port)
		return
	if "--gui" in sys.argv:
		gui_main()
		return
	print("AI CHESS BOT")
	print("You are White. Enter moves like e4, Nf3, or e2e4.")
	print("Commands: help, moves, undo, quit")
	difficulty = input("Difficulty (1 = easy, 2 = medium, 3 = hard) [2]: ").strip() or "2"
	depth = max(1, min(3, int(difficulty)))
	board = chess.Board()
	history: list[chess.Move] = []

	while not board.is_game_over(claim_draw=True):
		print_board(board)
		if board.turn == chess.WHITE:
			text = input("Your move: ").strip()
			if text.lower() in {"quit", "exit"}:
				print("Good game!")
				return
			if text.lower() == "help":
				print("Use SAN (e4, Nf3, O-O) or UCI (e2e4). Type moves for legal moves.")
				continue
			if text.lower() == "moves":
				print(" ".join(board.san(move) for move in board.legal_moves))
				continue
			if text.lower() == "undo":
				if len(history) >= 2:
					board.pop()
					board.pop()
					history = history[:-2]
				else:
					print("Nothing to undo.")
				continue
			move = parse_move(board, text)
			if move is None:
				print("That move is not legal. Try e4, Nf3, or type moves.")
				continue
		else:
			print("AI is thinking...")
			move = choose_move(board, depth)
			print(f"AI plays {board.san(move)}")

		board.push(move)
		history.append(move)

	print_board(board)
	if board.is_checkmate():
		winner = "Black" if board.turn == chess.WHITE else "White"
		print(f"CHECKMATE - {winner} wins!")
	else:
		print("Result:", board.result(claim_draw=True), "-", board.outcome(claim_draw=True).termination.name)


if __name__ == "__main__":
	main()
